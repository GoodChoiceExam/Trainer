@page "/trainers/list"
@model FitLife.Trainer.Api.Pages.TrainerListModel

<!DOCTYPE html>
<html>
<head>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
        crossorigin="anonymous">
    <meta name="viewport" content="width=device-width" />
    <title>FitLife Trainers</title>
    <style>
        table { border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 8px 12px; }
    </style>
</head>
<body>
    <div style="width: 800px; margin: auto">
        <div>
            <h1>FitLife Trainers</h1>
            <a href="/landing">&larr; Back to landing page</a>
        </div>
        <hr />

        @if (Model.Trainers != null && Model.Trainers.Count > 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Specialty</th>
                        <th>Rating</th>
                        <th>Sessions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Trainers)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Specialty</td>
                            <td>@item.Rating</td>
                            <td>@item.SessionCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No trainers found. Add some trainers via the API first.</p>
        }

        <hr />
        <small>Served by: @Model.Hostname &mdash; Hosted via FitLife Trainer service (Micro Frontend)</small>
    </div>
</body>
</html>
